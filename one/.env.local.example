# 复制为 .env.local 后填写真实值（.env.local 已在 .gitignore 中，不会被提交）

# ---- 腾讯云 COS 密钥：唯一需要保密的部分 ----
# CI 上配在仓库 Settings → Secrets and variables → Actions
COS_SECRET_ID=
COS_SECRET_KEY=

# 下面是公开信息，已写死在 script/upload-one-data.js，通常不用改：
#   bucket = mike-1255355338
#   region = ap-guangzhou
#   key    = one/one-data.json
#   CDN    = https://cdn.uwayfly.com/one/one-data.json
#
# 需要临时换环境时才在这里覆盖：
# COS_BUCKET=
# COS_REGION=
# COS_KEY=

# ---- 前端运行时拉取的 CDN 地址（VITE_ 前缀才会被打进前端产物）----
# config.ts 已内置 https://cdn.uwayfly.com/one/one-data.json，一般不用配
# VITE_ONE_DATA_URL=
