# 复制为 .env.local 后填写真实值（.env.local 已在 .gitignore 中，不会被提交）

# ---- 腾讯云 COS（上传 one-data.json 用，仅本地/CI 执行，不进前端产物）----
COS_SECRET_ID=
COS_SECRET_KEY=
# 桶名，形如 one-1250000000
COS_BUCKET=
# 地域，形如 ap-guangzhou
COS_REGION=
# 对象路径，默认 one/one-data.json
COS_KEY=one/one-data.json
# 仅用于上传后打印提示，可留空
COS_CDN_URL=

# ---- 前端运行时拉取数据的 CDN 地址（VITE_ 前缀才会被打进前端产物）----
# 需要和上面的 COS_KEY / COS_CDN_URL 对应
VITE_ONE_DATA_URL=
